# Railway Environment Variables for E-Lingkod Dasol HRIS
# Copy these to your Railway project environment variables

# ===================================================================
# APPLICATION SETTINGS
# ===================================================================
APP_NAME="E-Lingkod Dasol HRIS"
APP_ENV=production
APP_DEBUG=false
APP_URL=${RAILWAY_PUBLIC_URL}
APP_KEY=base64:SWLhXQa+HwGZ1lUAdJxQ1luTfpv1hmxTnzQ5V2Uiz2Y=

# ===================================================================
# DATABASE CONFIGURATION (Railway MySQL Service)
# ===================================================================
DB_CONNECTION=mysql
DB_HOST=${RAILWAY_PRIVATE_MYSQL_SERVICE_HOST}
DB_PORT=${RAILWAY_PRIVATE_MYSQL_SERVICE_PORT}
DB_DATABASE=${RAILWAY_PRIVATE_MYSQL_SERVICE_DATABASE}
DB_USERNAME=${RAILWAY_PRIVATE_MYSQL_SERVICE_USERNAME}
DB_PASSWORD=${RAILWAY_PRIVATE_MYSQL_SERVICE_PASSWORD}

# ===================================================================
# CACHE & SESSION CONFIGURATION (Railway Redis Service)
# ===================================================================
CACHE_DRIVER=redis
CACHE_STORE=redis
REDIS_HOST=${RAILWAY_PRIVATE_REDIS_SERVICE_HOST}
REDIS_PORT=${RAILWAY_PRIVATE_REDIS_SERVICE_PORT}
REDIS_PASSWORD=${RAILWAY_PRIVATE_REDIS_SERVICE_PASSWORD}

SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis

# ===================================================================
# LOGGING CONFIGURATION
# ===================================================================
LOG_CHANNEL=stderr
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null

# ===================================================================
# FILE UPLOAD & MEMORY SETTINGS
# ===================================================================
PHP_MEMORY_LIMIT=512M
PHP_MAX_EXECUTION_TIME=300
PHP_UPLOAD_MAX_FILESIZE=64M
PHP_POST_MAX_SIZE=64M

# ===================================================================
# LARAVEL SPECIFIC SETTINGS
# ===================================================================
COMPOSER_ALLOW_SUPERUSER=1
COMPOSER_MEMORY_LIMIT=2G

# ===================================================================
# MAIL CONFIGURATION (Optional - for HR notifications)
# ===================================================================
MAIL_MAILER=smtp
MAIL_HOST=${RAILWAY_PRIVATE_MAIL_SERVICE_HOST:-smtp.mailtrap.io}
MAIL_PORT=${RAILWAY_PRIVATE_MAIL_SERVICE_PORT:-2525}
MAIL_USERNAME=${RAILWAY_PRIVATE_MAIL_SERVICE_USERNAME}
MAIL_PASSWORD=${RAILWAY_PRIVATE_MAIL_SERVICE_PASSWORD}
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hris@dasol.gov.ph"
MAIL_FROM_NAME="${APP_NAME}"

# ===================================================================
# SECURITY SETTINGS
# =================================================================##
BCRYPT_ROUNDS=12

# ===================================================================
# PERFORMANCE SETTINGS
# ===================================================================
# PHP-FPM Configuration
PHP_MEMORY_LIMIT=512M
PHP_MAX_EXECUTION_TIME=300
PHP_UPLOAD_MAX_FILESIZE=64M
PHP_POST_MAX_SIZE=64M

# Nginx Configuration
NGINX_WORKER_PROCESSES=auto
NGINX_WORKER_CONNECTIONS=1024

# ===================================================================
# BACKUP CONFIGURATION (Optional)
# ===================================================================
BACKUP_DISK=local
BACKUP_PATH=storage/backups